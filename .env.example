# Server Configuration
PORT=3000
NODE_ENV=development

# ============================================
# AI Provider Configuration
# ============================================

# Provider: 'anthropic' (direct connection) or 'litellm' (proxy for multi-model support)
# Default: anthropic
AI_PROVIDER=anthropic

# --- Anthropic Direct Connection ---
# Ottieni la tua API key da: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# AI Model Configuration (for Anthropic Direct)
# Available models: claude-opus-4-5-20251101, claude-sonnet-4-5-20250929, claude-haiku-3-5-20250116
AI_MODEL=claude-sonnet-4-5-20250929

# --- LiteLLM Proxy Configuration ---
# Enable this section if using AI_PROVIDER=litellm
# LiteLLM allows using 100+ models (OpenAI, Google, Azure, Anthropic, etc.) through a unified proxy

# LiteLLM Proxy URL (default: http://localhost:4000)
LITELLM_PROXY_URL=http://localhost:4000

# LiteLLM API Key (optional, depends on your proxy configuration)
LITELLM_API_KEY=sk-litellm-your-key

# Default model for LiteLLM
# Examples: claude-sonnet-4-5-20250929, gpt-4-turbo, gpt-3.5-turbo, gemini-pro, mistral-large
LITELLM_MODEL=claude-sonnet-4-5-20250929

# --- Model Routing (Optional) ---
# Use different models for different task complexities to optimize costs

# Simple tasks (git status, file reading, basic queries)
LITELLM_MODEL_SIMPLE=gpt-3.5-turbo

# Advanced tasks (code review, architecture design, complex problem solving)
LITELLM_MODEL_ADVANCED=claude-opus-4-5

# Fast tasks (code generation, quick responses)
LITELLM_MODEL_FAST=gpt-4-turbo

# Advanced Features
ENABLE_TOOL_USE=true
ENABLE_PLANNING=true
ENABLE_MEMORY=true
MAX_TOKENS=8192

# Mossab Personality
MOSSAB_NAME=Mossab
MOSSAB_ROLE=AI Developer & Programming Assistant
