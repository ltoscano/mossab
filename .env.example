# Server Configuration
PORT=3000
NODE_ENV=development

# Anthropic Claude API
# Ottieni la tua API key da: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# AI Configuration
# Modelli disponibili: claude-opus-4-5-20251101, claude-sonnet-4-5-20250929, claude-haiku-3-5-20250116
AI_MODEL=claude-sonnet-4-5-20250929

# Advanced Features
ENABLE_TOOL_USE=true
ENABLE_PLANNING=true
ENABLE_MEMORY=true
MAX_TOKENS=8192

# Mossab Personality
MOSSAB_NAME=Mossab
MOSSAB_ROLE=AI Developer & Programming Assistant
